{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sandbox": "vite --open /sandbox.html",
    "drill": "vite --open /drill.html",
    "assets:stage": "node ../tools/stage-dev-assets.mjs",
    "clip:moves": "node ../tools/what-moves.mjs",
    "dev:beta": "vite --base=/beta/",
    "build": "tsc -b && vite build",
    "build:beta": "tsc -b && vite build --base=/beta/",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "env:check": "node ../tools/env-requirements/preflight.mjs",
    "env:fingerprint": "node ../tools/env-requirements/preflight.mjs --fingerprint",
    "gen:actions": "node ../tools/gen-actions/gen.mjs",
    "gen:actions:check": "node ../tools/gen-actions/gen.mjs --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "^0.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "spacetimedb": "^2.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.0.0"
  }
}
